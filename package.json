{
  "name": "quran-lawh",
  "private": true,
  "version": "0.3.0",
  "description": "لَوْح – احفظ وراجع: a free, ad-free, offline Quran app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data": "npm install --no-save quran-json@3.1.2 quran-meta@7.0.0 && node scripts/build-data.mjs",
    "verify-text": "node scripts/verify-text.mjs",
    "icons": "node scripts/build-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "check-reciters": "node scripts/check-reciters.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
